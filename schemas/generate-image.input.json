{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenCLI generate-image input",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "output"],
  "properties": {
    "prompt": {"type": "string", "minLength": 1, "maxLength": 32000, "pattern": "\\S"},
    "output": {"type": "string", "minLength": 1, "description": "Local output path; parent must exist; existing files are never overwritten. Extension must match output_format. URLs, UNC/device paths, ADS and Windows reserved names are rejected."},
    "model": {"enum": ["gpt-image-2", "gpt-image-1.5", "gpt-image-1-mini"], "default": "gpt-image-2"},
    "size": {"enum": ["1024x1024", "1536x1024", "1024x1536"], "default": "1024x1024"},
    "quality": {"enum": ["low", "medium", "high"], "default": "medium"},
    "output_format": {"enum": ["png", "jpeg", "webp"], "default": "png"},
    "background": {"enum": ["opaque", "transparent", "auto"], "default": "opaque"}
  },
  "allOf": [{"if": {"properties": {"output_format": {"const": "jpeg"}}, "required": ["output_format"]}, "then": {"properties": {"background": {"enum": ["opaque", "auto"]}}}}]
}
